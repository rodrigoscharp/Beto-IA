# Serviço local de voz do Beto. Copie para .env (não vai para o git).

# A voz vem do VoiceStudio no Mac (sem chave). Só mude se ele não estiver no endereço padrão.
# VOICESTUDIO_URL=http://127.0.0.1:3900

# Token que o serviço usa para falar com /api/chat. O MESMO valor vai na Vercel como VOICE_SERVICE_TOKEN.
# Gere com: openssl rand -hex 32
VOICE_SERVICE_TOKEN=

# Onde está o cérebro (sobrescreve [brain].url do beto-voice.toml).
# BRAIN_URL=https://beto-ia.vercel.app
