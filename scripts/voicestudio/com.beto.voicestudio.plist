<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo do LaunchAgent que mantém o VoiceStudio (a voz do Beto) sempre ligado.
     Não instale à mão: scripts/voicestudio/install.sh preenche os __MARCADORES__ e carrega no launchd.
     Roda o uvicorn direto (o `bun run dev:api` recarrega a cada mudança de arquivo, o que não serve aqui). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.beto.voicestudio</string>

  <key>WorkingDirectory</key>
  <string>__VOICESTUDIO_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <!-- HTTPS com o certificado local do mkcert: o Safari não deixa uma página https (o Beto na Vercel) chamar http.
         serve_tls.py em vez de "uvicorn --ssl-*": o truststore do VoiceStudio quebra o TLS do servidor (ver o arquivo). -->
    <string>__VOICESTUDIO_DIR__/.venv/bin/python</string>
    <string>__HERE__/serve_tls.py</string>
    <string>--app-dir</string>
    <string>backend</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>3900</string>
    <string>--cert</string>
    <string>__CERT__</string>
    <string>--key</string>
    <string>__KEY__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Origens que podem pedir voz pelo navegador: as padrão do VoiceStudio + o Beto (Vercel, proxy do Safari e npm run dev). -->
    <!-- O motor de voz desliga depois de ficar parado este tanto de segundos (padrão do VoiceStudio: 300). Religar leva
         mais que o prazo de uma frase, e as primeiras falas depois de 5 min parado sumiam. 1 h: fica pronto enquanto
         o Beto está em uso e ainda libera a memória quando ninguém usa. -->
    <key>OMNIVOICE_SIDECAR_IDLE_TIMEOUT_S</key>
    <string>3600</string>
    <key>OMNIVOICE_ALLOWED_ORIGINS</key>
    <string>https://localhost:3900,https://127.0.0.1:3900,http://localhost:3900,http://127.0.0.1:3900,https://betoia.vercel.app,https://localhost:3443,http://localhost:3000</string>
    <key>PATH</key>
    <string>__HOME__/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- Caiu, volta sozinho. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/voicestudio.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/voicestudio.log</string>
</dict>
</plist>
